# The firmware fork is its own repository (github.com/MaxwellDeJong/busybar-firmware).
busybar-firmware/

# Device recovery bundles — large firmware images. Re-download + SHA-256 verify
# from https://update.busy.app/busybar-firmware/directory.json (see the plan, §9.2).
recovery/

# Python bytecode / virtualenvs
__pycache__/
*.pyc
.venv/
venv/

# Local compose config
.env

# Recorder output: session logs and raw snapshot dumps live in the bind-mounted
# data/ dir. Keep the dir in the tree but never commit its contents.
data/*
!data/.gitkeep
