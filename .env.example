# Copy to .env and adjust. `docker compose` reads .env automatically.

# Address of the Busy Bar on your LAN (must be routable from the Docker host).
BUSY_ADDR=10.0.4.20

# Count work done past the timer until the break is manually started (1/0).
FLOW_OVERTIME=1

# Host port the dashboard is published on.
DASHBOARD_PORT=8501
