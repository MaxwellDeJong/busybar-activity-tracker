# Copy to .env and adjust. `docker compose` reads .env automatically.

# Local timezone the dashboard renders session times in. Logs are stored in UTC
# and carry no zone, so this must be set to your zone (IANA name). Without it the
# containers default to UTC and every displayed time is shifted.
TZ=America/New_York

# --- MQTT transport (default) ----------------------------------------------
# The recorder subscribes to this broker; the compose broker is reachable
# in-network at mosquitto:1883. Unset MQTT_BROKER to fall back to the WebSocket
# at BUSY_ADDR instead.
MQTT_BROKER=mosquitto:1883
# The firmware publishes timer snapshots on the session scope once the device is
# linked (the linker service completes that link — see docs/mqtt-migration.md §6).
# The single-level `+` wildcard matches whatever session_id the linker minted, so
# re-links don't break the subscription.
MQTT_TOPIC=sessions/+/up/v1/busy/snapshot
# Durable client id — keep STABLE so the broker buffers QoS-1 messages for this
# subscriber across restarts. Changing it starts a fresh (empty) session.
MQTT_CLIENT_ID=busybar-recorder
# Host port the broker is published on — the port the BAR connects to at your
# homelab's LAN IP (mqtt://<homelab-ip>:${MQTT_PORT}). Open this to the bar's IP.
MQTT_PORT=1883

# --- Linker (completes the device's account link on the homelab) -----------
# The bar only publishes snapshots once it is *linked*; the linker plays the
# vendor cloud far enough to flip it to linked (docs/mqtt-migration.md §6). The
# email/user_id are cosmetic — they show as the "linked account" on the device.
LINKER_STATE=/data/linker_state.json
# Seconds before the linker re-tokens the same bar on presence. Swallows the
# device's own post-link reconnect, but lets the linker auto-recover if a bar
# resets its link state on reboot (it re-links on the next presence past this).
LINKER_COOLDOWN_S=60
LINK_EMAIL=homelab@local
LINK_USER_ID=homelab

# Address of the Busy Bar on your LAN — only used for the WebSocket fallback
# (when MQTT_BROKER is unset). Must be routable from the Docker host.
BUSY_ADDR=10.0.4.20

# Count work done past the timer until the break is manually started (1/0).
FLOW_OVERTIME=1

# Host port the dashboard is published on.
DASHBOARD_PORT=8501
